-- Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

-- Fling Function (ปรับปรุงให้แรงขึ้นและก้าวร้าว)
local function flingPlayer(target)
    if not target or target == LocalPlayer then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local targetChar = target.Character
    local targetHrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")

    if hrp and targetHrp and hum then
        local originalCFrame = hrp.CFrame
        hum.PlatformStand = true
        
        -- Loop ก่อกวนฟิสิกส์ให้กระเด็นแบบรุนแรง
        local connection
        connection = RunService.Heartbeat:Connect(function()
            if targetHrp and targetHrp.Parent then
                hrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 0)
                hrp.AssemblyLinearVelocity = Vector3.new(100000, 100000, 100000)
                hrp.AssemblyAngularVelocity = Vector3.new(100000, 100000, 100000)
            else
                connection:Disconnect()
            end
        end)

        task.wait(0.6) -- ระยะเวลาในการซัด
        connection:Disconnect()
        
        hum.PlatformStand = false
        hrp.CFrame = originalCFrame
        Rayfield:Notify({Title = "สำเร็จ!", Content = "ซัด " .. target.Name .. " เรียบร้อย!", Duration = 2})
    end
end

-- Function หา Roles
local function getRole(player)
   if not player or not player.Character then return "Innocent" end
   local backpack = player:FindFirstChild("Backpack")
   local char = player.Character
   local hasKnife = char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife"))
   local hasGun = char:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun"))
   if hasKnife then return "Murderer" end
   if hasGun then return "Sheriff" end
   return "Innocent"
end

